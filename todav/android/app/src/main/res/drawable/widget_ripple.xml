<?xml version="1.0" encoding="utf-8"?>
<!-- A widget's row or day pressed: grey enough to see on light and dark backgrounds, in rounded
     corners (Glance's default, the theme's selectableItemBackground, hardly shows there). -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#40808080">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</ripple>
