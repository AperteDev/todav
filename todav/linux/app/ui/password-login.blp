using Gtk 4.0;
using Adw 1;

// Signing in with a login name and app password instead of the browser.
Adw.Dialog dialog {
  title: "Sign In with Password";
  content-width: 420;
  default-widget: sign_in;
  focus-widget: user;

  child: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      show-start-title-buttons: false;
      show-end-title-buttons: false;

      [start]
      Gtk.Button cancel {
        label: "Cancel";
      }

      [end]
      Gtk.Button sign_in {
        label: "Sign In";
        sensitive: false;
        styles ["suggested-action"]
      }
    }

    // Why the last attempt failed; hidden again on typing.
    [top]
    Adw.Banner error {}

    content: Adw.PreferencesGroup {
      description: "Create an app password in Nextcloud under Settings → Security";
      margin-top: 12;
      margin-bottom: 24;
      margin-start: 18;
      margin-end: 18;

      Adw.EntryRow user {
        title: "Login name";
        activates-default: true;
      }

      Adw.PasswordEntryRow password {
        title: "App password";
        activates-default: true;
      }
    };
  };
}
