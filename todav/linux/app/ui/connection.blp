using Gtk 4.0;
using Adw 1;

// Rows shared by the welcome page and Preferences → General; each adds them to its own group.

Adw.SwitchRow goa {
  title: _("Use GNOME Online Accounts");
}

Adw.ComboRow goa_account {
  title: _("Account");
  model: Gtk.StringList goa_names {};
}

Adw.EntryRow server {
  title: _("Nextcloud server");

  [prefix]
  Gtk.DropDown server_scheme {
    valign: center;
    model: Gtk.StringList { strings ["https", "http"] };
    styles ["flat"]
  }
}
