using Gtk 4.0;
using Adw 1;

// The Calendar page: a mini month and the calendars beside the Month / Week / Agenda views.
// Its breakpoints are set in code.
Adw.NavigationSplitView split {
  min-sidebar-width: 300;
  max-sidebar-width: 340;

  // The page's shortcuts, while it is shown (listed in ui/shortcuts.blp).
  Gtk.ShortcutController {
    scope: managed;

    Gtk.Shortcut {
      trigger: "<Control>n";
      action: "action(cal.new-event)";
    }

    Gtk.Shortcut {
      trigger: "<Control>t";
      action: "action(cal.today)";
    }

    Gtk.Shortcut {
      trigger: "<Alt>Left|Page_Up";
      action: "action(cal.previous)";
    }

    Gtk.Shortcut {
      trigger: "<Alt>Right|Page_Down";
      action: "action(cal.next)";
    }

    Gtk.Shortcut {
      trigger: "<Control>1";
      action: "action(cal.view)";
      arguments: "'month'";
    }

    Gtk.Shortcut {
      trigger: "<Control>2";
      action: "action(cal.view)";
      arguments: "'week'";
    }

    Gtk.Shortcut {
      trigger: "<Control>3";
      action: "action(cal.view)";
      arguments: "'agenda'";
    }
  }

  sidebar: Adw.NavigationPage {
    title: "Calendar";

    child: Adw.ToolbarView {
      [top]
      Adw.HeaderBar {
        // Its stack (the window's Tasks / Calendar views) is set in code.
        title-widget: Adw.InlineViewSwitcher switcher {};

        [end]
        Gtk.MenuButton {
          icon-name: "open-menu-symbolic";
          menu-model: main_menu;
        }
      }

      content: Gtk.ScrolledWindow {
        vexpand: true;
        hscrollbar-policy: never;

        Gtk.Box {
          orientation: vertical;
          spacing: 6;

          // Filled in code (src/calendar/mini.rs).
          Gtk.Box mini {
            orientation: vertical;
            margin-start: 12;
            margin-end: 12;
            margin-top: 6;
            styles ["card", "mini"]
          }

          // Each section folds under its heading, as the Tasks page's categories do.
          Gtk.ToggleButton calendars_toggle {
            active: true;
            margin-start: 6;
            margin-end: 6;
            styles ["flat", "cat-toggle"]

            Gtk.Box {
              spacing: 6;

              Gtk.Label {
                label: "Calendars";
                xalign: 0;
                hexpand: true;
                styles ["heading"]
              }

              Gtk.Image {
                icon-name: "pan-down-symbolic";
              }
            }
          }

          Gtk.Revealer {
            reveal-child: bind calendars_toggle.active;

            // A row per calendar: colour, name, shown or not.
            Gtk.ListBox calendars {
              selection-mode: none;
              styles ["navigation-sidebar"]
            }
          }

          Gtk.ToggleButton task_heading {
            active: true;
            margin-start: 6;
            margin-end: 6;
            styles ["flat", "cat-toggle"]

            Gtk.Box {
              spacing: 6;

              Gtk.Label {
                label: "Task lists";
                xalign: 0;
                hexpand: true;
                styles ["heading"]
              }

              Gtk.Image {
                icon-name: "pan-down-symbolic";
              }
            }
          }

          Gtk.Revealer {
            reveal-child: bind task_heading.active;

            // The same for lists holding only tasks (their dated tasks are on the calendar).
            Gtk.ListBox task_lists {
              selection-mode: none;
              styles ["navigation-sidebar"]
            }
          }

          Gtk.ToggleButton plan_heading {
            active: true;
            margin-start: 6;
            margin-end: 6;
            tooltip-text: "Drag a task onto a day or an hour";
            styles ["flat", "cat-toggle"]

            Gtk.Box {
              spacing: 6;

              Gtk.Label {
                label: "To Plan";
                xalign: 0;
                hexpand: true;
                styles ["heading"]
              }

              Gtk.Image {
                icon-name: "pan-down-symbolic";
              }
            }
          }

          Gtk.Revealer {
            reveal-child: bind plan_heading.active;

            // Open tasks without a time slot: due by a date (by the end of the shown range,
            // overdue included), then undated. Dropping a planned task here takes it out of
            // its slot.
            Gtk.ListBox plan {
              selection-mode: none;
              margin-bottom: 12;
              styles ["navigation-sidebar"]
            }
          }
        }
      };
    };
  };

  content: Adw.NavigationPage {
    title: "Calendar";

    child: Adw.ToolbarView {
      [top]
      Adw.HeaderBar {
        title-widget: Adw.WindowTitle title {};

        [start]
        Gtk.Box {
          styles ["linked"]

          Gtk.Button {
            icon-name: "go-previous-symbolic";
            tooltip-text: "Previous (Alt+←)";
            action-name: "cal.previous";
          }

          Gtk.Button {
            icon-name: "calendar-go-today-symbolic";
            tooltip-text: "Today (Ctrl+T)";
            action-name: "cal.today";
          }

          Gtk.Button {
            icon-name: "go-next-symbolic";
            tooltip-text: "Next (Alt+→)";
            action-name: "cal.next";
          }
        }

        [start]
        Gtk.Button {
          icon-name: "list-add-symbolic";
          tooltip-text: "New Event (Ctrl+N)";
          action-name: "cal.new-event";
          styles ["suggested-action"]
        }

        // The icon, or a spinner while syncing.
        [end]
        Gtk.Button sync {
          tooltip-text: "Sync (F5)";
          action-name: "app.sync";
          styles ["image-button"]

          Gtk.Stack sync_state {
            transition-type: crossfade;

            Gtk.StackPage {
              name: "idle";
              child: Gtk.Image {
                icon-name: "view-refresh-symbolic";
              };
            }

            Gtk.StackPage {
              name: "syncing";
              child: Adw.Spinner {};
            }
          }
        }

        [end]
        Gtk.ToggleButton search_button {
          icon-name: "system-search-symbolic";
          tooltip-text: "Search (Ctrl+F)";

          Gtk.ShortcutController {
            scope: managed;

            Gtk.Shortcut {
              trigger: "<Control>f";
              action: "activate";
            }
          }
        }

        [end]
        Adw.ToggleGroup mode {
          Adw.Toggle {
            name: "month";
            icon-name: "view-grid-symbolic";
            tooltip: "Month (Ctrl+1)";
          }

          Adw.Toggle {
            name: "week";
            icon-name: "view-column-symbolic";
            tooltip: "Week (Ctrl+2)";
          }

          Adw.Toggle {
            name: "agenda";
            icon-name: "view-list-symbolic";
            tooltip: "Agenda (Ctrl+3)";
          }
        }
      }

      // Typing on the page opens it too (its key capture widget is set in code). Results show
      // in the agenda's place.
      [top]
      Gtk.SearchBar search {
        search-mode-enabled: bind search_button.active bidirectional;

        Adw.Clamp {
          maximum-size: 720;
          hexpand: true;

          Gtk.SearchEntry query {
            placeholder-text: "Search events";
            hexpand: true;
          }
        }
      }

      // The same choice at the bottom when the window is narrow (the header has no room).
      [bottom]
      Gtk.ActionBar mode_bar {
        revealed: false;

        [center]
        Adw.ToggleGroup mode_narrow {
          Adw.Toggle {
            name: "month";
            icon-name: "view-grid-symbolic";
            tooltip: "Month (Ctrl+1)";
          }

          Adw.Toggle {
            name: "week";
            icon-name: "view-column-symbolic";
            tooltip: "Week (Ctrl+2)";
          }

          Adw.Toggle {
            name: "agenda";
            icon-name: "view-list-symbolic";
            tooltip: "Agenda (Ctrl+3)";
          }
        }
      }

      content: Gtk.Stack views {
        transition-type: crossfade;

        Gtk.StackPage {
          name: "month";

          // Weekday names over six rows of seven days, filled in code.
          child: Gtk.Box {
            orientation: vertical;
            margin-start: 6;
            margin-end: 6;
            margin-bottom: 6;
            styles ["month"]

            Gtk.Box weekdays {
              homogeneous: true;
              styles ["weekdays"]
            }

            // Scrolls when the window is too short for six rows.
            Gtk.ScrolledWindow {
              vexpand: true;
              hscrollbar-policy: never;

              Gtk.Grid month {
                row-homogeneous: true;
                column-homogeneous: true;
                vexpand: true;
              }
            }
          };
        }

        Gtk.StackPage {
          name: "week";

          // Day names, then all-day items, then the hours; each row has the hour gutter on
          // the left, so the columns line up.
          child: Gtk.Box {
            orientation: vertical;
            styles ["week"]

            Gtk.Box week_head {
              styles ["weekdays"]
            }

            Gtk.Box week_all_day {
              styles ["all-day-row"]
            }

            Gtk.ScrolledWindow week_scroll {
              vexpand: true;
              hscrollbar-policy: never;

              // Blocks are overlay children, placed in code.
              Gtk.Overlay week_grid {
                child: Gtk.Box {
                  Gtk.Box hours {
                    orientation: vertical;
                    styles ["hours"]
                  }

                  Gtk.DrawingArea week_lines {
                    hexpand: true;
                  }
                };
              }
            }
          };
        }

        Gtk.StackPage {
          name: "agenda";

          child: Gtk.ScrolledWindow {
            vexpand: true;

            Adw.Clamp {
              maximum-size: 720;

              Gtk.Box agenda {
                orientation: vertical;
                spacing: 18;
                margin-top: 12;
                margin-bottom: 24;
                margin-start: 12;
                margin-end: 12;
              }
            }
          };
        }
      };
    };
  };
}

menu main_menu {
  item ("Preferences", "win.preferences")
  item ("Keyboard Shortcuts", "app.shortcuts")
  item ("Quit", "app.quit")
}
