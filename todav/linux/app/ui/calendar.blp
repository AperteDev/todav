using Gtk 4.0;
using Adw 1;

// The Calendar page: a mini month and the calendars beside the Month / Week / Agenda views.
// Its breakpoints are set in code.
Adw.NavigationSplitView split {
  min-sidebar-width: 300;
  max-sidebar-width: 340;

  // Ctrl+N while the page has the focus (the Tasks page adds tasks from its entry).
  Gtk.ShortcutController {
    scope: managed;

    Gtk.Shortcut {
      trigger: "<Control>n";
      action: "action(cal.new-event)";
    }
  }

  sidebar: Adw.NavigationPage {
    title: "Calendar";

    child: Adw.ToolbarView {
      [top]
      Adw.HeaderBar {
        // Its stack (the window's Tasks / Calendar views) is set in code.
        title-widget: Adw.InlineViewSwitcher switcher {};

        [end]
        Gtk.MenuButton {
          icon-name: "open-menu-symbolic";
          menu-model: main_menu;
        }
      }

      content: Gtk.ScrolledWindow {
        vexpand: true;
        hscrollbar-policy: never;

        Gtk.Box {
          orientation: vertical;
          spacing: 6;

          Gtk.Calendar mini {
            margin-start: 12;
            margin-end: 12;
            margin-top: 6;
            styles ["card"]
          }

          // The heading's button shows or hides all of them; its mark tells how many show.
          Gtk.Box {
            margin-start: 18;
            margin-end: 6;
            margin-top: 6;

            Gtk.Label {
              label: "Calendars";
              xalign: 0;
              hexpand: true;
              styles ["heading"]
            }

            Gtk.Button all_calendars {
              valign: center;
              styles ["flat"]
            }
          }

          // A row per calendar: colour, name, shown or not.
          Gtk.ListBox calendars {
            selection-mode: none;
            styles ["navigation-sidebar"]
          }

          Gtk.Box task_heading {
            margin-start: 18;
            margin-end: 6;
            margin-top: 6;

            Gtk.Label {
              label: "Task lists";
              xalign: 0;
              hexpand: true;
              styles ["heading"]
            }

            Gtk.Button all_task_lists {
              valign: center;
              styles ["flat"]
            }
          }

          // The same for lists holding only tasks (their dated tasks are on the calendar).
          Gtk.ListBox task_lists {
            selection-mode: none;
            styles ["navigation-sidebar"]
          }

          Gtk.Label plan_heading {
            label: "To Plan";
            xalign: 0;
            margin-start: 18;
            margin-top: 12;
            tooltip-text: "Drag a task onto a day or an hour";
            styles ["heading"]
          }

          // Open tasks without a time slot: undated, or due by the end of the shown range.
          // Dropping a planned task here takes it out of its slot.
          Gtk.ListBox plan {
            selection-mode: none;
            margin-bottom: 12;
            styles ["navigation-sidebar"]
          }
        }
      };
    };
  };

  content: Adw.NavigationPage {
    title: "Calendar";

    child: Adw.ToolbarView {
      [top]
      Adw.HeaderBar {
        title-widget: Adw.WindowTitle title {};

        [start]
        Gtk.Box {
          styles ["linked"]

          Gtk.Button prev {
            icon-name: "go-previous-symbolic";
            tooltip-text: "Previous";
          }

          Gtk.Button today {
            label: "Today";
          }

          Gtk.Button next {
            icon-name: "go-next-symbolic";
            tooltip-text: "Next";
          }
        }

        [start]
        Gtk.Button {
          icon-name: "list-add-symbolic";
          tooltip-text: "New Event (Ctrl+N)";
          action-name: "cal.new-event";
          styles ["suggested-action"]
        }

        // The icon, or a spinner while syncing.
        [end]
        Gtk.Button sync {
          tooltip-text: "Sync (F5)";
          action-name: "app.sync";
          styles ["image-button"]

          Gtk.Stack sync_state {
            transition-type: crossfade;

            Gtk.StackPage {
              name: "idle";
              child: Gtk.Image {
                icon-name: "view-refresh-symbolic";
              };
            }

            Gtk.StackPage {
              name: "syncing";
              child: Adw.Spinner {};
            }
          }
        }

        [end]
        Gtk.ToggleButton search_button {
          icon-name: "system-search-symbolic";
          tooltip-text: "Search (Ctrl+F)";

          Gtk.ShortcutController {
            scope: managed;

            Gtk.Shortcut {
              trigger: "<Control>f";
              action: "activate";
            }
          }
        }

        [end]
        Adw.ToggleGroup mode {
          Adw.Toggle {
            name: "month";
            icon-name: "view-grid-symbolic";
            tooltip: "Month";
          }

          Adw.Toggle {
            name: "week";
            icon-name: "view-column-symbolic";
            tooltip: "Week";
          }

          Adw.Toggle {
            name: "agenda";
            icon-name: "view-list-symbolic";
            tooltip: "Agenda";
          }
        }
      }

      // Typing on the page opens it too (its key capture widget is set in code). Results show
      // in the agenda's place.
      [top]
      Gtk.SearchBar search {
        search-mode-enabled: bind search_button.active bidirectional;

        Adw.Clamp {
          maximum-size: 720;
          hexpand: true;

          Gtk.SearchEntry query {
            placeholder-text: "Search events";
            hexpand: true;
          }
        }
      }

      // The same choice at the bottom when the window is narrow (the header has no room).
      [bottom]
      Gtk.ActionBar mode_bar {
        revealed: false;

        [center]
        Adw.ToggleGroup mode_narrow {
          Adw.Toggle {
            name: "month";
            icon-name: "view-grid-symbolic";
            tooltip: "Month";
          }

          Adw.Toggle {
            name: "week";
            icon-name: "view-column-symbolic";
            tooltip: "Week";
          }

          Adw.Toggle {
            name: "agenda";
            icon-name: "view-list-symbolic";
            tooltip: "Agenda";
          }
        }
      }

      content: Gtk.Stack views {
        transition-type: crossfade;

        Gtk.StackPage {
          name: "month";

          // Weekday names over six rows of seven days, filled in code.
          child: Gtk.Box {
            orientation: vertical;
            margin-start: 6;
            margin-end: 6;
            margin-bottom: 6;
            styles ["month"]

            Gtk.Box weekdays {
              homogeneous: true;
              styles ["weekdays"]
            }

            // Scrolls when the window is too short for six rows.
            Gtk.ScrolledWindow {
              vexpand: true;
              hscrollbar-policy: never;

              Gtk.Grid month {
                row-homogeneous: true;
                column-homogeneous: true;
                vexpand: true;
              }
            }
          };
        }

        Gtk.StackPage {
          name: "week";

          // Day names, then all-day items, then the hours; each row has the hour gutter on
          // the left, so the columns line up.
          child: Gtk.Box {
            orientation: vertical;
            styles ["week"]

            Gtk.Box week_head {
              styles ["weekdays"]
            }

            Gtk.Box week_all_day {
              styles ["all-day-row"]
            }

            Gtk.ScrolledWindow week_scroll {
              vexpand: true;
              hscrollbar-policy: never;

              // Blocks are overlay children, placed in code.
              Gtk.Overlay week_grid {
                child: Gtk.Box {
                  Gtk.Box hours {
                    orientation: vertical;
                    styles ["hours"]
                  }

                  Gtk.DrawingArea week_lines {
                    hexpand: true;
                  }
                };
              }
            }
          };
        }

        Gtk.StackPage {
          name: "agenda";

          child: Gtk.ScrolledWindow {
            vexpand: true;

            Adw.Clamp {
              maximum-size: 720;

              Gtk.Box agenda {
                orientation: vertical;
                spacing: 18;
                margin-top: 12;
                margin-bottom: 24;
                margin-start: 12;
                margin-end: 12;
              }
            }
          };
        }
      };
    };
  };
}

menu main_menu {
  item ("Preferences", "win.preferences")
  item ("Quit", "app.quit")
}
