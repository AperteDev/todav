using Gtk 4.0;
using Adw 1;

// Two columns (the task, then its dates and reminders); one below the other when narrow.
Adw.Dialog dialog {
  title: "Edit Task";
  content-width: 760;
  // Room for an expanded date; smaller windows shrink it.
  content-height: 640;
  // Breakpoints need a minimum size; the smallest GNOME supports.
  width-request: 360;
  height-request: 294;
  default-widget: save;

  child: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      show-start-title-buttons: false;
      show-end-title-buttons: false;

      [start]
      Gtk.Button cancel {
        label: "Cancel";
      }

      [end]
      Gtk.Button save {
        label: "Save";
        styles ["suggested-action"]
      }
    }

    // What the format asks of both dates, when they break it (text set in code): what to
    // change before saving.
    [top]
    Adw.Banner conflict {
      use-markup: false;
      styles ["warning"]
    }

    content: Gtk.ScrolledWindow {
      hscrollbar-policy: never;
      propagate-natural-height: true;

      Gtk.Box columns {
        vexpand: true;
        spacing: 18;
        homogeneous: true;
        margin-top: 12;
        margin-bottom: 18;
        margin-start: 18;
        margin-end: 18;

        // The note fills what the rows above it leave.
        Gtk.Box {
          orientation: vertical;
          spacing: 18;

          // Why the server refused the task as it is (the reason set in code, as written).
          Adw.PreferencesGroup refused_group {
            visible: false;

            Adw.ActionRow refused {
              title: "Not saved on the server";
              subtitle-selectable: true;
              use-markup: false;

              [prefix]
              Gtk.Image {
                icon-name: "dialog-warning-symbolic";
                styles ["warning"]
              }
            }
          }

          Adw.PreferencesGroup {
            Adw.EntryRow summary {
              title: "Title";
              activates-default: true;
            }

            Adw.ComboRow category {
              title: "Category";
              model: Gtk.StringList cats {};
            }

            // Stored as 1 (high), 5 (medium) or 9 (low), as Nextcloud Tasks does.
            Adw.ComboRow priority {
              title: "Priority";
              model: Gtk.StringList { strings ["None", "Low", "Medium", "High"] };
            }

            // Only for a task linked to an event (from the event's details).
            Adw.ActionRow event {
              title: "For Event";
              visible: false;

              [suffix]
              Gtk.Button unlink {
                icon-name: "edit-clear-symbolic";
                tooltip-text: "Unlink From Event";
                valign: center;
                styles ["flat"]
              }
            }
          }

          Adw.PreferencesGroup {
            title: "Note";
            vexpand: true;

            Gtk.ScrolledWindow {
              vexpand: true;
              height-request: 160;
              hscrollbar-policy: never;
              styles ["card"]

              Gtk.TextView description {
                wrap-mode: word_char;
                top-margin: 12;
                bottom-margin: 12;
                left-margin: 12;
                right-margin: 12;
                styles ["inline"]
              }
            }
          }
        }

        Gtk.Box {
          orientation: vertical;
          spacing: 18;
          valign: start;

          // Start and due are both optional and independent: planned for a time, due by one.
          Adw.PreferencesGroup {
            Adw.ExpanderRow start {
              title: "Start";
              show-enable-switch: true;
              enable-expansion: false;

              Gtk.ListBoxRow {
                activatable: false;

                Gtk.Calendar start_calendar {
                  margin-top: 6;
                  margin-bottom: 6;
                  margin-start: 6;
                  margin-end: 6;
                }
              }

              // The time, used while the switch is on.
              Adw.ActionRow start_time_row {
                activatable-widget: start_has_time;

                [prefix]
                Gtk.Box {
                  spacing: 6;
                  valign: center;
                  sensitive: bind start_has_time.active;

                  Gtk.SpinButton start_hour {
                    numeric: true;
                    wrap: true;
                    adjustment: Gtk.Adjustment {
                      lower: 0;
                      upper: 23;
                      step-increment: 1;
                    };
                  }

                  Gtk.Label {
                    label: ":";
                  }

                  Gtk.SpinButton start_minute {
                    numeric: true;
                    wrap: true;
                    adjustment: Gtk.Adjustment {
                      lower: 0;
                      upper: 59;
                      step-increment: 5;
                    };
                  }
                }

                [suffix]
                Gtk.Switch start_has_time {
                  valign: center;
                }
              }
            }

            Adw.ExpanderRow due {
              title: "Due Date";
              show-enable-switch: true;
              enable-expansion: false;

              Gtk.ListBoxRow {
                activatable: false;

                Gtk.Calendar due_calendar {
                  margin-top: 6;
                  margin-bottom: 6;
                  margin-start: 6;
                  margin-end: 6;
                }
              }

              Adw.ActionRow due_time_row {
                activatable-widget: due_has_time;

                [prefix]
                Gtk.Box {
                  spacing: 6;
                  valign: center;
                  sensitive: bind due_has_time.active;

                  Gtk.SpinButton due_hour {
                    numeric: true;
                    wrap: true;
                    adjustment: Gtk.Adjustment {
                      lower: 0;
                      upper: 23;
                      step-increment: 1;
                    };
                  }

                  Gtk.Label {
                    label: ":";
                  }

                  Gtk.SpinButton due_minute {
                    numeric: true;
                    wrap: true;
                    adjustment: Gtk.Adjustment {
                      lower: 0;
                      upper: 59;
                      step-increment: 5;
                    };
                  }
                }

                [suffix]
                Gtk.Switch due_has_time {
                  valign: center;
                }
              }
            }
          }

          // Reminders (ui/reminder.blp) go above the button; they count from the due date.
          Gtk.ListBox reminders {
            selection-mode: none;
            visible: bind due.enable-expansion;
            styles ["boxed-list"]

            Adw.ButtonRow add_reminder {
              title: "Add Reminder";
              start-icon-name: "list-add-symbolic";
            }
          }

          // As in the event dialog; a toast offers to undo it.
          Gtk.ListBox {
            selection-mode: none;
            styles ["boxed-list"]

            Adw.ButtonRow delete {
              title: "Delete Task";
              styles ["destructive-action"]
            }
          }
        }
      }
    };
  };

  Adw.Breakpoint {
    condition ("max-width: 560sp")

    // One column: the dates open collapsed, so the task's own fields come first.
    setters {
      columns.orientation: vertical;
      columns.homogeneous: false;
      start.expanded: false;
      due.expanded: false;
    }
  }
}
