using Gtk 4.0;
using Adw 1;

// Two columns (the task, then its due date and reminders); one below the other when narrow.
Adw.Dialog dialog {
  title: "Edit Task";
  content-width: 760;
  // Room for the expanded due date; smaller windows shrink it.
  content-height: 600;
  default-widget: save;

  child: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      show-start-title-buttons: false;
      show-end-title-buttons: false;

      [start]
      Gtk.Button cancel {
        label: "Cancel";
      }

      [end]
      Gtk.Button save {
        label: "Save";
        styles ["suggested-action"]
      }
    }

    content: Gtk.ScrolledWindow {
      hscrollbar-policy: never;
      propagate-natural-height: true;

      Gtk.Box columns {
        vexpand: true;
        spacing: 18;
        homogeneous: true;
        margin-top: 12;
        margin-bottom: 18;
        margin-start: 18;
        margin-end: 18;

        // The note fills what the title and category leave.
        Gtk.Box {
          orientation: vertical;
          spacing: 18;

          Adw.PreferencesGroup {
            Adw.EntryRow summary {
              title: "Title";
              activates-default: true;
            }

            Adw.ComboRow category {
              title: "Category";
              model: Gtk.StringList cats {};
            }
          }

          Adw.PreferencesGroup {
            title: "Note";
            vexpand: true;

            Gtk.ScrolledWindow {
              vexpand: true;
              height-request: 160;
              hscrollbar-policy: never;
              styles ["card"]

              Gtk.TextView description {
                wrap-mode: word_char;
                top-margin: 12;
                bottom-margin: 12;
                left-margin: 12;
                right-margin: 12;
                styles ["inline"]
              }
            }
          }
        }

        Gtk.Box {
          orientation: vertical;
          spacing: 18;
          valign: start;

          Adw.PreferencesGroup {
            Adw.ExpanderRow due {
              title: "Due Date";
              show-enable-switch: true;
              enable-expansion: false;

              Gtk.ListBoxRow {
                activatable: false;

                Gtk.Calendar calendar {
                  margin-top: 6;
                  margin-bottom: 6;
                  margin-start: 6;
                  margin-end: 6;
                }
              }

              Adw.SwitchRow has_time {
                title: "Time";
              }

              Adw.ActionRow time_row {
                title: "At";
                visible: bind has_time.active;

                [suffix]
                Gtk.SpinButton hour {
                  valign: center;
                  numeric: true;
                  wrap: true;
                  adjustment: Gtk.Adjustment {
                    lower: 0;
                    upper: 23;
                    step-increment: 1;
                  };
                }

                [suffix]
                Gtk.Label {
                  label: ":";
                }

                [suffix]
                Gtk.SpinButton minute {
                  valign: center;
                  numeric: true;
                  wrap: true;
                  adjustment: Gtk.Adjustment {
                    lower: 0;
                    upper: 59;
                    step-increment: 5;
                  };
                }
              }
            }
          }

          // Reminders (ui/reminder.blp) go above the button.
          Gtk.ListBox reminders {
            selection-mode: none;
            visible: bind due.enable-expansion;
            styles ["boxed-list"]

            Adw.ButtonRow add_reminder {
              title: "Add Reminder";
              start-icon-name: "list-add-symbolic";
            }
          }
        }
      }
    };
  };

  Adw.Breakpoint {
    condition ("max-width: 560sp")

    // One column: the due date opens collapsed, so the task's own fields come first.
    setters {
      columns.orientation: vertical;
      columns.homogeneous: false;
      due.expanded: false;
    }
  }
}
