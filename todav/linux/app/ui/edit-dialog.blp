using Gtk 4.0;
using Adw 1;

// Two columns (the task, then its dates and reminders); one below the other when narrow.
Adw.Dialog dialog {
  title: "Edit Task";
  content-width: 760;
  // Room for an expanded date; smaller windows shrink it.
  content-height: 640;
  // Breakpoints need a minimum size; the smallest GNOME supports.
  width-request: 360;
  height-request: 294;
  default-widget: save;

  child: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      show-start-title-buttons: false;
      show-end-title-buttons: false;

      [start]
      Gtk.Button cancel {
        label: "Cancel";
      }

      [end]
      Gtk.Button save {
        label: "Save";
        styles ["suggested-action"]
      }
    }

    content: Gtk.ScrolledWindow {
      hscrollbar-policy: never;
      propagate-natural-height: true;

      Gtk.Box columns {
        vexpand: true;
        spacing: 18;
        homogeneous: true;
        margin-top: 12;
        margin-bottom: 18;
        margin-start: 18;
        margin-end: 18;

        // The note fills what the rows above it leave.
        Gtk.Box {
          orientation: vertical;
          spacing: 18;

          Adw.PreferencesGroup {
            Adw.EntryRow summary {
              title: "Title";
              activates-default: true;
            }

            Adw.ComboRow category {
              title: "Category";
              model: Gtk.StringList cats {};
            }

            // Stored as 1 (high), 5 (medium) or 9 (low), as Nextcloud Tasks does.
            Adw.ComboRow priority {
              title: "Priority";
              model: Gtk.StringList { strings ["None", "Low", "Medium", "High"] };
            }

            // Only for a task linked to an event (from the event's details).
            Adw.ActionRow event {
              title: "For Event";
              visible: false;

              [suffix]
              Gtk.Button unlink {
                icon-name: "edit-clear-symbolic";
                tooltip-text: "Unlink From Event";
                valign: center;
                styles ["flat"]
              }
            }
          }

          Adw.PreferencesGroup {
            title: "Note";
            vexpand: true;

            Gtk.ScrolledWindow {
              vexpand: true;
              height-request: 160;
              hscrollbar-policy: never;
              styles ["card"]

              Gtk.TextView description {
                wrap-mode: word_char;
                top-margin: 12;
                bottom-margin: 12;
                left-margin: 12;
                right-margin: 12;
                styles ["inline"]
              }
            }
          }
        }

        Gtk.Box {
          orientation: vertical;
          spacing: 18;
          valign: start;

          // What the format asks of both dates, when they break it (text set in code). Above the
          // dates, so it shows while either is changed.
          Gtk.Label conflict {
            xalign: 0;
            wrap: true;
            visible: false;
            styles ["error"]
          }

          // Start and due are both optional and independent: planned for a time, due by one.
          Adw.PreferencesGroup {
            Adw.ExpanderRow start {
              title: "Start";
              show-enable-switch: true;
              enable-expansion: false;

              Gtk.ListBoxRow {
                activatable: false;

                Gtk.Calendar start_calendar {
                  margin-top: 6;
                  margin-bottom: 6;
                  margin-start: 6;
                  margin-end: 6;
                }
              }

              Adw.SwitchRow start_has_time {
                title: "Time";
              }

              Adw.ActionRow {
                title: "At";
                visible: bind start_has_time.active;

                [suffix]
                Gtk.SpinButton start_hour {
                  valign: center;
                  numeric: true;
                  wrap: true;
                  adjustment: Gtk.Adjustment {
                    lower: 0;
                    upper: 23;
                    step-increment: 1;
                  };
                }

                [suffix]
                Gtk.Label {
                  label: ":";
                }

                [suffix]
                Gtk.SpinButton start_minute {
                  valign: center;
                  numeric: true;
                  wrap: true;
                  adjustment: Gtk.Adjustment {
                    lower: 0;
                    upper: 59;
                    step-increment: 5;
                  };
                }
              }
            }

            Adw.ExpanderRow due {
              title: "Due Date";
              show-enable-switch: true;
              enable-expansion: false;

              Gtk.ListBoxRow {
                activatable: false;

                Gtk.Calendar due_calendar {
                  margin-top: 6;
                  margin-bottom: 6;
                  margin-start: 6;
                  margin-end: 6;
                }
              }

              Adw.SwitchRow due_has_time {
                title: "Time";
              }

              Adw.ActionRow {
                title: "At";
                visible: bind due_has_time.active;

                [suffix]
                Gtk.SpinButton due_hour {
                  valign: center;
                  numeric: true;
                  wrap: true;
                  adjustment: Gtk.Adjustment {
                    lower: 0;
                    upper: 23;
                    step-increment: 1;
                  };
                }

                [suffix]
                Gtk.Label {
                  label: ":";
                }

                [suffix]
                Gtk.SpinButton due_minute {
                  valign: center;
                  numeric: true;
                  wrap: true;
                  adjustment: Gtk.Adjustment {
                    lower: 0;
                    upper: 59;
                    step-increment: 5;
                  };
                }
              }
            }
          }

          // Reminders (ui/reminder.blp) go above the button; they count from the due date.
          Gtk.ListBox reminders {
            selection-mode: none;
            visible: bind due.enable-expansion;
            styles ["boxed-list"]

            Adw.ButtonRow add_reminder {
              title: "Add Reminder";
              start-icon-name: "list-add-symbolic";
            }
          }
        }
      }
    };
  };

  Adw.Breakpoint {
    condition ("max-width: 560sp")

    // One column: the dates open collapsed, so the task's own fields come first.
    setters {
      columns.orientation: vertical;
      columns.homogeneous: false;
      start.expanded: false;
      due.expanded: false;
    }
  }
}
