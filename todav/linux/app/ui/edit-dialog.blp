using Gtk 4.0;
using Adw 1;

Adw.AlertDialog dialog {
  heading: "Edit Task";
  default-response: "save";

  extra-child: Adw.PreferencesGroup {
    Adw.EntryRow summary {
      title: "Title";
    }

    Adw.ComboRow category {
      title: "Category";
      model: Gtk.StringList cats {};
    }

    Adw.EntryRow description {
      title: "Note";
    }

    Adw.ExpanderRow due {
      title: "Due Date";
      show-enable-switch: true;
      enable-expansion: false;

      Gtk.ListBoxRow {
        activatable: false;

        Gtk.Calendar calendar {
          margin-top: 6;
          margin-bottom: 6;
          margin-start: 6;
          margin-end: 6;
        }
      }

      Adw.SwitchRow has_time {
        title: "Time";
      }

      Adw.ActionRow time_row {
        title: "At";
        visible: bind has_time.active;

        [suffix]
        Gtk.SpinButton hour {
          valign: center;
          numeric: true;
          wrap: true;
          adjustment: Gtk.Adjustment {
            lower: 0;
            upper: 23;
            step-increment: 1;
          };
        }

        [suffix]
        Gtk.Label {
          label: ":";
        }

        [suffix]
        Gtk.SpinButton minute {
          valign: center;
          numeric: true;
          wrap: true;
          adjustment: Gtk.Adjustment {
            lower: 0;
            upper: 59;
            step-increment: 5;
          };
        }
      }

      // Each reminder adds its rows (ui/reminder.blp) after this one.
      Adw.ActionRow reminders_header {
        title: "Reminders";

        [suffix]
        Gtk.Button add_reminder {
          icon-name: "list-add-symbolic";
          tooltip-text: "Add Reminder";
          valign: center;
          styles ["flat"]
        }
      }
    }
  };

  responses [
    cancel: "Cancel",
    save: "Save" suggested,
  ]
}
