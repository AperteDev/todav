using Gtk 4.0;
using Adw 1;

Adw.AlertDialog dialog {
  heading: "Edit Task";
  default-response: "save";

  extra-child: Adw.PreferencesGroup {
    Adw.EntryRow summary {
      title: "Title";
    }

    Adw.ComboRow category {
      title: "Category";
      model: Gtk.StringList cats {};
    }

    Adw.EntryRow description {
      title: "Note";
    }

    Adw.ExpanderRow due {
      title: "Due Date";
      show-enable-switch: true;
      enable-expansion: false;

      Gtk.ListBoxRow {
        activatable: false;

        Gtk.Calendar calendar {
          margin-top: 6;
          margin-bottom: 6;
          margin-start: 6;
          margin-end: 6;
        }
      }

      Adw.SwitchRow has_time {
        title: "Time";
      }

      Adw.ActionRow time_row {
        title: "At";
        visible: bind has_time.active;

        [suffix]
        Gtk.SpinButton hour {
          valign: center;
          numeric: true;
          wrap: true;
          adjustment: Gtk.Adjustment {
            lower: 0;
            upper: 23;
            step-increment: 1;
          };
        }

        [suffix]
        Gtk.Label {
          label: ":";
        }

        [suffix]
        Gtk.SpinButton minute {
          valign: center;
          numeric: true;
          wrap: true;
          adjustment: Gtk.Adjustment {
            lower: 0;
            upper: 59;
            step-increment: 5;
          };
        }
      }

      Adw.ComboRow reminder {
        title: "Reminder";
        model: Gtk.StringList reminders {};
      }

      // Shown for the "Custom…" reminder.
      Gtk.ListBoxRow custom_row {
        activatable: false;
        visible: false;

        Gtk.Box {
          halign: center;
          spacing: 6;
          margin-top: 8;
          margin-bottom: 8;
          margin-start: 8;
          margin-end: 8;

          Gtk.SpinButton custom_amount {
            valign: center;
            numeric: true;
            adjustment: Gtk.Adjustment {
              lower: 0;
              upper: 999;
              step-increment: 1;
            };
          }

          Gtk.DropDown custom_unit {
            valign: center;
            model: Gtk.StringList { strings ["minutes", "hours", "days", "weeks"] };
          }

          Gtk.DropDown custom_dir {
            valign: center;
            model: Gtk.StringList custom_dirs {};
          }
        }
      }
    }
  };

  responses [
    cancel: "Cancel",
    save: "Save" suggested,
  ]
}
