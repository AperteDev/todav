using Gtk 4.0;
using Adw 1;

// A new event or an existing one, laid out as the task dialog: what, where, which calendar and
// notes; then when, how it repeats and its reminders. One column when narrow.
Adw.Dialog dialog {
  title: _("Event");
  content-width: 760;
  // Room for an expanded date with the repeat and reminders below it; smaller windows shrink it.
  content-height: 760;
  // Breakpoints need a minimum size; the smallest GNOME supports.
  width-request: 360;
  height-request: 294;
  default-widget: save;
  focus-widget: summary;

  child: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      show-start-title-buttons: false;
      show-end-title-buttons: false;

      [start]
      Gtk.Button cancel {
        label: _("Cancel");
      }

      [end]
      Gtk.Button save {
        label: _("Save");
        styles ["suggested-action"]
      }
    }

    content: Gtk.ScrolledWindow {
      hscrollbar-policy: never;
      propagate-natural-height: true;

      Gtk.Box columns {
        vexpand: true;
        spacing: 18;
        homogeneous: true;
        margin-top: 12;
        margin-bottom: 18;
        margin-start: 18;
        margin-end: 18;

        // The notes fill what the rows above them leave.
        Gtk.Box {
          orientation: vertical;
          spacing: 18;

          Adw.PreferencesGroup {
            Adw.EntryRow summary {
              title: _("Title");
              activates-default: true;
            }

            Adw.EntryRow location {
              title: _("Location");
              activates-default: true;
            }

            // Its model is set in code, grouped by where the calendars are kept.
            Adw.ComboRow calendar {
              title: _("Calendar");
            }

            // As a task's (edit-dialog.blp), and as Thunderbird sets it on events.
            Adw.ComboRow priority {
              title: _("Priority");
              model: Gtk.StringList { strings [C_("priority", "None"), C_("priority", "Low"), C_("priority", "Medium"), C_("priority", "High")] };
            }
          }

          Adw.PreferencesGroup {
            title: _("Notes");
            vexpand: true;

            Gtk.ScrolledWindow {
              vexpand: true;
              height-request: 160;
              hscrollbar-policy: never;
              styles ["card"]

              Gtk.TextView description {
                wrap-mode: word_char;
                top-margin: 12;
                bottom-margin: 12;
                left-margin: 12;
                right-margin: 12;
                styles ["inline"]
              }
            }
          }
        }

        Gtk.Box {
          orientation: vertical;
          spacing: 18;
          valign: start;

          // Start and end as the task's dates: a calendar, and the time unless all day. Their
          // subtitles say what is picked.
          Adw.PreferencesGroup {
            Adw.SwitchRow all_day {
              title: _("All Day");
            }

            Adw.ExpanderRow start {
              title: _("Starts");
              expanded: true;

              Gtk.ListBoxRow {
                activatable: false;

                Gtk.Calendar start_cal {
                  margin-top: 6;
                  margin-bottom: 6;
                  margin-start: 6;
                  margin-end: 6;
                }
              }

              Adw.ActionRow start_time {
                title: _("Time");

                [suffix]
                Gtk.Box {
                  spacing: 6;
                  valign: center;

                  Gtk.SpinButton start_hour {
                    numeric: true;
                    wrap: true;
                    adjustment: Gtk.Adjustment {
                      lower: 0;
                      upper: 23;
                      step-increment: 1;
                    };
                  }

                  Gtk.Label {
                    label: ":";
                  }

                  Gtk.SpinButton start_minute {
                    numeric: true;
                    wrap: true;
                    adjustment: Gtk.Adjustment {
                      lower: 0;
                      upper: 59;
                      step-increment: 5;
                    };
                  }
                }
              }
            }

            Adw.ExpanderRow end {
              title: _("Ends");

              Gtk.ListBoxRow {
                activatable: false;

                Gtk.Calendar end_cal {
                  margin-top: 6;
                  margin-bottom: 6;
                  margin-start: 6;
                  margin-end: 6;
                }
              }

              Adw.ActionRow end_time {
                title: _("Time");

                [suffix]
                Gtk.Box {
                  spacing: 6;
                  valign: center;

                  Gtk.SpinButton end_hour {
                    numeric: true;
                    wrap: true;
                    adjustment: Gtk.Adjustment {
                      lower: 0;
                      upper: 23;
                      step-increment: 1;
                    };
                  }

                  Gtk.Label {
                    label: ":";
                  }

                  Gtk.SpinButton end_minute {
                    numeric: true;
                    wrap: true;
                    adjustment: Gtk.Adjustment {
                      lower: 0;
                      upper: 59;
                      step-increment: 5;
                    };
                  }
                }
              }
            }
          }

          Adw.PreferencesGroup {
            Adw.ComboRow repeat {
              title: _("Repeat");
              model: Gtk.StringList repeats { strings [_("Does Not Repeat"), _("Daily"), _("Weekly"), _("Monthly"), _("Yearly")] };
            }

            Adw.SpinRow interval {
              title: _("Every");
              adjustment: Gtk.Adjustment {
                lower: 1;
                upper: 99;
                step-increment: 1;
              };
            }

            Adw.ExpanderRow until {
              title: _("Until");
              show-enable-switch: true;
              enable-expansion: false;

              Gtk.ListBoxRow {
                activatable: false;

                Gtk.Calendar until_cal {
                  margin-top: 6;
                  margin-bottom: 6;
                  margin-start: 6;
                  margin-end: 6;
                }
              }
            }
          }

          // Reminders (ui/reminder.blp) go above the button; they count from the start.
          Gtk.ListBox reminders {
            selection-mode: none;
            styles ["boxed-list"]

            Adw.ButtonRow add_reminder {
              title: _("Add Reminder");
              start-icon-name: "list-add-symbolic";
            }
          }

          Gtk.ListBox delete_box {
            selection-mode: none;
            styles ["boxed-list"]

            // A link that opens the event in Todav, to paste elsewhere.
            Adw.ButtonRow copy_link {
              title: _("Copy Link");
              start-icon-name: "edit-copy-symbolic";
            }

            Adw.ButtonRow delete {
              title: _("Delete Event");
              styles ["destructive-action"]
            }
          }
        }
      }
    };
  };

  Adw.Breakpoint {
    condition ("max-width: 560sp")

    // One column: the dates collapse, so the event's own fields come first.
    setters {
      columns.orientation: vertical;
      columns.homogeneous: false;
      start.expanded: false;
    }
  }
}
