using Gtk 4.0;
using Adw 1;

// A new event or an existing one, laid out as the task dialog: what, where, which calendar and
// notes; then when, how it repeats and its reminders. One column when narrow.
Adw.Dialog dialog {
  title: "Event";
  content-width: 760;
  content-height: 640;
  // Breakpoints need a minimum size; the smallest GNOME supports.
  width-request: 360;
  height-request: 294;
  default-widget: save;
  focus-widget: summary;

  child: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      show-start-title-buttons: false;
      show-end-title-buttons: false;

      [start]
      Gtk.Button cancel {
        label: "Cancel";
      }

      [end]
      Gtk.Button save {
        label: "Save";
        styles ["suggested-action"]
      }
    }

    content: Gtk.ScrolledWindow {
      hscrollbar-policy: never;
      propagate-natural-height: true;

      Gtk.Box columns {
        vexpand: true;
        spacing: 18;
        homogeneous: true;
        margin-top: 12;
        margin-bottom: 18;
        margin-start: 18;
        margin-end: 18;

        // The notes fill what the rows above them leave.
        Gtk.Box {
          orientation: vertical;
          spacing: 18;

          Adw.PreferencesGroup {
            Adw.EntryRow summary {
              title: "Title";
              activates-default: true;
            }

            Adw.EntryRow location {
              title: "Location";
              activates-default: true;
            }

            Adw.ComboRow calendar {
              title: "Calendar";
              model: Gtk.StringList calendars {};
            }
          }

          Adw.PreferencesGroup {
            title: "Notes";
            vexpand: true;

            Gtk.ScrolledWindow {
              vexpand: true;
              height-request: 160;
              hscrollbar-policy: never;
              styles ["card"]

              Gtk.TextView description {
                wrap-mode: word_char;
                top-margin: 12;
                bottom-margin: 12;
                left-margin: 12;
                right-margin: 12;
                styles ["inline"]
              }
            }
          }
        }

        Gtk.Box {
          orientation: vertical;
          spacing: 18;
          valign: start;

          // Start and end as the task's dates: a calendar, and the time unless all day. Their
          // subtitles say what is picked.
          Adw.PreferencesGroup {
            Adw.SwitchRow all_day {
              title: "All Day";
            }

            Adw.ExpanderRow start {
              title: "Starts";
              expanded: true;

              Gtk.ListBoxRow {
                activatable: false;

                Gtk.Calendar start_cal {
                  margin-top: 6;
                  margin-bottom: 6;
                  margin-start: 6;
                  margin-end: 6;
                }
              }

              Adw.ActionRow start_time {
                title: "Time";

                [suffix]
                Gtk.Box {
                  spacing: 6;
                  valign: center;

                  Gtk.SpinButton start_hour {
                    numeric: true;
                    wrap: true;
                    adjustment: Gtk.Adjustment {
                      lower: 0;
                      upper: 23;
                      step-increment: 1;
                    };
                  }

                  Gtk.Label {
                    label: ":";
                  }

                  Gtk.SpinButton start_minute {
                    numeric: true;
                    wrap: true;
                    adjustment: Gtk.Adjustment {
                      lower: 0;
                      upper: 59;
                      step-increment: 5;
                    };
                  }
                }
              }
            }

            Adw.ExpanderRow end {
              title: "Ends";

              Gtk.ListBoxRow {
                activatable: false;

                Gtk.Calendar end_cal {
                  margin-top: 6;
                  margin-bottom: 6;
                  margin-start: 6;
                  margin-end: 6;
                }
              }

              Adw.ActionRow end_time {
                title: "Time";

                [suffix]
                Gtk.Box {
                  spacing: 6;
                  valign: center;

                  Gtk.SpinButton end_hour {
                    numeric: true;
                    wrap: true;
                    adjustment: Gtk.Adjustment {
                      lower: 0;
                      upper: 23;
                      step-increment: 1;
                    };
                  }

                  Gtk.Label {
                    label: ":";
                  }

                  Gtk.SpinButton end_minute {
                    numeric: true;
                    wrap: true;
                    adjustment: Gtk.Adjustment {
                      lower: 0;
                      upper: 59;
                      step-increment: 5;
                    };
                  }
                }
              }
            }
          }

          Adw.PreferencesGroup {
            Adw.ComboRow repeat {
              title: "Repeat";
              model: Gtk.StringList repeats { strings ["Does Not Repeat", "Daily", "Weekly", "Monthly", "Yearly"] };
            }

            Adw.SpinRow interval {
              title: "Every";
              adjustment: Gtk.Adjustment {
                lower: 1;
                upper: 99;
                step-increment: 1;
              };
            }

            Adw.ExpanderRow until {
              title: "Until";
              show-enable-switch: true;
              enable-expansion: false;

              Gtk.ListBoxRow {
                activatable: false;

                Gtk.Calendar until_cal {
                  margin-top: 6;
                  margin-bottom: 6;
                  margin-start: 6;
                  margin-end: 6;
                }
              }
            }
          }

          // Reminders (ui/reminder.blp) go above the button; they count from the start.
          Gtk.ListBox reminders {
            selection-mode: none;
            styles ["boxed-list"]

            Adw.ButtonRow add_reminder {
              title: "Add Reminder";
              start-icon-name: "list-add-symbolic";
            }
          }

          Gtk.ListBox delete_box {
            selection-mode: none;
            styles ["boxed-list"]

            Adw.ButtonRow delete {
              title: "Delete Event";
              styles ["destructive-action"]
            }
          }
        }
      }
    };
  };

  Adw.Breakpoint {
    condition ("max-width: 560sp")

    // One column: the dates collapse, so the event's own fields come first.
    setters {
      columns.orientation: vertical;
      columns.homogeneous: false;
      start.expanded: false;
    }
  }
}
