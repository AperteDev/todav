using Gtk 4.0;
using Adw 1;

// A new task list or calendar, or one to rename, recolour, lock or delete (src/lists.rs).
Adw.Dialog dialog {
  content-width: 380;
  default-widget: save;
  focus-widget: name;

  child: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      show-start-title-buttons: false;
      show-end-title-buttons: false;

      [start]
      Gtk.Button cancel {
        label: _("Cancel");
      }

      [end]
      Gtk.Button save {
        label: _("Save");
        sensitive: false;
        styles ["suggested-action"]
      }
    }

    [top]
    Adw.Banner error {}

    content: Gtk.Box {
      orientation: vertical;
      spacing: 18;
      margin-top: 12;
      margin-bottom: 18;
      margin-start: 12;
      margin-end: 12;

      Adw.PreferencesGroup {
        Adw.EntryRow name {
          title: _("Name");
          activates-default: true;
        }

        // Where a new one goes, when there is a choice (local mode with an account).
        Adw.ComboRow place {
          title: _("Save to");
          visible: false;
          model: Gtk.StringList places {};
        }
      }

      Adw.PreferencesGroup {
        title: _("Color");

        // Nextcloud's presets, then a custom colour (filled in code).
        Gtk.Grid colors {
          halign: center;
          column-spacing: 8;
          row-spacing: 8;
        }
      }

      // Whether it may be changed here, for one that exists (src/lists.rs); off and disabled
      // for one its account allows no changes to.
      Adw.PreferencesGroup editing_group {
        visible: false;

        Adw.SwitchRow editing {
          title: _("Allow Editing");
        }
      }

      Gtk.ListBox delete_box {
        selection-mode: none;
        styles ["boxed-list"]

        // Its events and tasks to an iCalendar file (src/lists.rs `export`).
        Adw.ButtonRow export {
          title: _("Export…");
          start-icon-name: "document-save-symbolic";
        }

        Adw.ButtonRow delete {
          styles ["destructive-action"]
        }
      }
    };
  };
}
