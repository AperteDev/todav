using Gtk 4.0;
using Adw 1;

Adw.ApplicationWindow window {
  title: "Todav";
  default-width: 900;
  default-height: 700;
  hide-on-close: true;

  content: Adw.ToastOverlay toasts {
    Gtk.Stack stack {
      Gtk.StackPage {
        name: "login";

        child: Adw.ToolbarView {
          [top]
          Adw.HeaderBar {}

          content: Adw.StatusPage {
            icon-name: "io.github.selfref.Todav";
            title: "Todav";
            description: _("Tasks synced with your Nextcloud");
            // A smaller icon and margins: the sign-in rows fit the default window size.
            styles ["compact"]

            Adw.Clamp {
              maximum-size: 420;

              Gtk.Box {
                orientation: vertical;
                spacing: 24;

                // Filled with the shared connection rows (ui/connection.blp).
                Adw.PreferencesGroup login_group {}

                Adw.PreferencesGroup {
                  Adw.EntryRow ntfy {
                    title: _("ntfy server for push (optional)");

                    [prefix]
                    Gtk.DropDown ntfy_scheme {
                      valign: center;
                      model: Gtk.StringList { strings ["https", "http"] };
                      styles ["flat"]
                    }
                  }
                }

                Gtk.Box {
                  orientation: vertical;
                  spacing: 6;

                  Gtk.Button connect_goa {
                    label: _("Connect");
                    halign: center;
                    styles ["suggested-action", "pill"]
                  }

                  Adw.SplitButton login {
                    label: _("Sign In with Browser");
                    menu-model: login_menu;
                    dropdown-tooltip: _("More Sign-In Options");
                    halign: center;
                    styles ["suggested-action", "pill"]
                  }

                  Gtk.Button cancel_login {
                    label: _("Cancel");
                    halign: center;
                    visible: false;
                    styles ["flat"]
                  }
                }
              }
            }
          };
        };
      }

      Gtk.StackPage {
        name: "main";

        // Tasks and Calendar; the calendar page (ui/calendar.blp) is added in code.
        child: Adw.ViewStack views {
          Adw.ViewStackPage {
            name: "tasks";
            title: _("Tasks");
            icon-name: "checkbox-checked-symbolic";

            // The same sidebar width as the Calendar page, so switching does not move it.
            child: Adw.NavigationSplitView split {
              min-sidebar-width: 300;
              max-sidebar-width: 340;

              sidebar: Adw.NavigationPage {
                title: "Todav";

                child: Adw.ToolbarView {
                  [top]
                  Adw.HeaderBar {
                    title-widget: Adw.InlineViewSwitcher {
                      stack: views;
                    };

                    [end]
                    Gtk.MenuButton {
                      icon-name: "open-menu-symbolic";
                      menu-model: main_menu;
                    }
                  }

                  content: Gtk.ScrolledWindow {
                    vexpand: true;

                    Gtk.Box {
                      orientation: vertical;

                      Gtk.ListBox sidebar {
                        styles ["navigation-sidebar"]
                      }

                      Gtk.Button {
                        action-name: "win.new-list";
                        margin-start: 6;
                        margin-end: 6;
                        styles ["flat"]

                        Adw.ButtonContent {
                          icon-name: "list-add-symbolic";
                          label: _("New List");
                          halign: start;
                        }
                      }

                      // Filled per list; hidden when the list has no categories.
                      Gtk.Box cat_section {
                        orientation: vertical;
                        visible: false;
                        margin-top: 6;

                        Gtk.ToggleButton cat_toggle {
                          active: true;
                          margin-start: 6;
                          margin-end: 6;
                          styles ["flat", "cat-toggle"]

                          Gtk.Box {
                            spacing: 6;

                            Gtk.Label {
                              label: _("Categories");
                              xalign: 0;
                              hexpand: true;
                              styles ["heading"]
                            }

                            Gtk.Image {
                              icon-name: "pan-down-symbolic";
                            }
                          }
                        }

                        Gtk.Revealer {
                          reveal-child: bind cat_toggle.active;

                          Gtk.ListBox cat_list {
                            styles ["navigation-sidebar"]
                          }
                        }
                      }
                    }
                  };
                };
              };

              content: Adw.NavigationPage {
                title: _("Tasks");

                child: Adw.ToolbarView {
                  [top]
                  Adw.HeaderBar {
                    title-widget: Adw.WindowTitle title {};

                    // The icon, or a spinner while syncing.
                    [end]
                    Gtk.Button {
                      tooltip-text: _("Sync (F5)");
                      action-name: "app.sync";
                      styles ["image-button"]

                      Gtk.Stack sync_state {
                        transition-type: crossfade;

                        Gtk.StackPage {
                          name: "idle";
                          child: Gtk.Image {
                            icon-name: "view-refresh-symbolic";
                          };
                        }

                        Gtk.StackPage {
                          name: "syncing";
                          child: Adw.Spinner {};
                        }
                      }
                    }

                    [end]
                    Gtk.ToggleButton task_search_button {
                      icon-name: "system-search-symbolic";
                      tooltip-text: _("Search (Ctrl+F)");

                      Gtk.ShortcutController {
                        scope: managed;

                        Gtk.Shortcut {
                          trigger: "<Control>f";
                          action: "activate";
                        }
                      }
                    }
                  }

                  // Typing on the page opens it too (its key capture widget is set in code).
                  [top]
                  Gtk.SearchBar task_search {
                    search-mode-enabled: bind task_search_button.active bidirectional;

                    Adw.Clamp {
                      maximum-size: 720;
                      hexpand: true;

                      Gtk.SearchEntry task_query {
                        placeholder-text: _("Search tasks");
                        hexpand: true;
                      }
                    }
                  }

                  content: Gtk.ScrolledWindow {
                    vexpand: true;

                    Adw.Clamp {
                      maximum-size: 720;

                      Gtk.Box {
                        orientation: vertical;
                        spacing: 18;
                        margin-top: 12;
                        margin-bottom: 24;
                        margin-start: 12;
                        margin-end: 12;

                        Gtk.Box {
                          spacing: 6;

                          Gtk.Entry entry {
                            placeholder-text: _("Add a task");
                            hexpand: true;
                          }

                          // The same as Enter, for touchscreens; only with something typed.
                          Gtk.Button add_task {
                            icon-name: "list-add-symbolic";
                            tooltip-text: _("Add Task");
                            sensitive: false;
                          }

                          Gtk.DropDown cat {
                            tooltip-text: _("Category (Ctrl+K)");
                            model: Gtk.StringList cats { strings [_("No category")] };

                            // Ctrl+K opens the category picker from anywhere in the window.
                            Gtk.ShortcutController {
                              scope: global;

                              Gtk.Shortcut {
                                trigger: "<Control>k";
                                action: "activate";
                              }
                            }
                          }
                        }

                        Gtk.Box groups {
                          orientation: vertical;
                          spacing: 18;
                        }
                      }
                    }
                  };
                };
              };
            };
          }
        };
      }
    }
  };

  // As the Calendar page's (src/calendar.rs).
  Adw.Breakpoint {
    condition ("max-width: 700sp")

    setters {
      split.collapsed: true;
    }
  }
}

menu main_menu {
  item (_("Preferences"), "win.preferences")
  item (_("Keyboard Shortcuts"), "app.shortcuts")
  item (_("About Todav"), "app.about")
  item (_("Quit"), "app.quit")
}

menu login_menu {
  item (_("Copy Login Link"), "win.copy-login")
  item (_("Sign In with Password…"), "win.password-login")
}
