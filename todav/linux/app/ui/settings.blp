using Gtk 4.0;
using Adw 1;

Adw.PreferencesDialog dialog {
  search-enabled: false;

  Adw.PreferencesPage {
    title: "Appearance";
    icon-name: "preferences-desktop-appearance-symbolic";

    Adw.PreferencesGroup {
      title: "Tasks";

      Adw.ComboRow task_sort {
        title: "Sort";
        model: Gtk.StringList { strings ["Manual", "Newest first", "Oldest first", "Due date, soonest first", "Due date, latest first"] };
      }

      Adw.ComboRow task_new {
        title: "Add new tasks";
        model: Gtk.StringList { strings ["At the start", "At the end"] };
      }

      Adw.ComboRow done_tasks {
        title: "Completed tasks";
        model: Gtk.StringList { strings ["In a separate group", "Keep in place"] };
      }
    }

    Adw.PreferencesGroup {
      title: "Subtasks";

      Adw.ComboRow sub_sort {
        title: "Sort";
        model: Gtk.StringList { strings ["Manual", "Newest first", "Oldest first", "Due date, soonest first", "Due date, latest first"] };
      }

      Adw.ComboRow sub_new {
        title: "Add new subtasks";
        model: Gtk.StringList { strings ["At the start", "At the end"] };
      }

      Adw.ComboRow done_subtasks {
        title: "Completed subtasks";
        model: Gtk.StringList { strings ["Show", "Hide"] };
      }
    }

    Adw.PreferencesGroup {
      title: "Reminders";

      Adw.ComboRow reminder_default {
        title: "New reminders";
        subtitle: "For tasks due at a time";
        model: Gtk.StringList reminder_defaults {};
      }

      Adw.ActionRow {
        title: "Time for all-day tasks";
        subtitle: "When reminders of tasks due on a date go off";

        [suffix]
        Gtk.SpinButton reminder_hour {
          valign: center;
          numeric: true;
          wrap: true;
          adjustment: Gtk.Adjustment {
            lower: 0;
            upper: 23;
            step-increment: 1;
          };
        }

        [suffix]
        Gtk.Label {
          label: ":";
        }

        [suffix]
        Gtk.SpinButton reminder_minute {
          valign: center;
          numeric: true;
          wrap: true;
          adjustment: Gtk.Adjustment {
            lower: 0;
            upper: 59;
            step-increment: 5;
          };
        }
      }
    }

    Adw.PreferencesGroup {
      title: "Categories";

      Adw.ComboRow category_view {
        title: "Show categories";
        model: Gtk.StringList { strings ["Group by category", "As tags", "Hide"] };
      }
    }

    Adw.PreferencesGroup {
      title: "Interaction";

      Adw.SwitchRow drag_handles {
        title: "Drag handles";
        subtitle: "Move tasks by a handle instead of the whole row, for touchscreens";
      }
    }
  }

  Adw.PreferencesPage {
    title: "Connection";
    icon-name: "network-server-symbolic";

    // The status row, then the shared connection rows (ui/connection.blp).
    Adw.PreferencesGroup account {
      title: "Account";

      // How Todav is connected now. Signed in here: "Sign Out", with signing in again in its
      // menu. Not connected: "Sign In with Browser". A GOA account is managed in GNOME Settings.
      Adw.ActionRow status {
        [prefix]
        Gtk.Image status_icon {
          icon-name: "object-select-symbolic";
          styles ["success"]
        }

        [suffix]
        Adw.SplitButton sign_out {
          label: "Sign Out";
          menu-model: sign_out_menu;
          dropdown-tooltip: "Sign In Again";
          valign: center;
          styles ["destructive-action"]
        }

        [suffix]
        Adw.SplitButton sign_in {
          label: "Sign In with Browser";
          menu-model: sign_in_menu;
          dropdown-tooltip: "More Sign-In Options";
          valign: center;
        }
      }
    }

    Adw.PreferencesGroup {
      title: "Push";
      description: "Changes are applied when this window closes";

      Adw.EntryRow ntfy {
        title: "ntfy server for push (optional)";

        [prefix]
        Gtk.DropDown ntfy_scheme {
          valign: center;
          model: Gtk.StringList { strings ["https", "http"] };
          styles ["flat"]
        }

        [suffix]
        Gtk.Button ntfy_test {
          label: "Test";
          valign: center;
          styles ["flat"]
        }
      }
    }

    Adw.PreferencesGroup {
      title: "Sync";

      Adw.SwitchRow sync_settings {
        title: "Sync settings with server";
        subtitle: "Server addresses always stay on this device";
        active: true;
      }
    }
  }
}

menu sign_out_menu {
  item ("Sign In Again", "account.sign-in")
  item ("Copy Login Link", "account.sign-in-copy")
}

menu sign_in_menu {
  item ("Copy Login Link", "account.sign-in-copy")
}
