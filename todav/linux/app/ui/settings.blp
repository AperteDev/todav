using Gtk 4.0;
using Adw 1;

Adw.PreferencesDialog dialog {
  search-enabled: false;

  Adw.PreferencesPage {
    title: _("General");
    icon-name: "preferences-system-symbolic";

    Adw.PreferencesGroup {
      title: _("Appearance");

      // Kept on this device only.
      Adw.ActionRow {
        title: _("Style");

        [suffix]
        Adw.ToggleGroup color_scheme {
          valign: center;

          Adw.Toggle {
            name: "system";
            label: C_("style", "System");
          }

          Adw.Toggle {
            name: "light";
            label: C_("style", "Light");
          }

          Adw.Toggle {
            name: "dark";
            label: C_("style", "Dark");
          }
        }
      }
    }

    Adw.PreferencesGroup {
      title: _("Startup");

      Adw.ComboRow start_view {
        title: _("Open at start");
        model: Gtk.StringList { strings [_("Last used"), _("Tasks"), _("Calendar")] };
      }
    }
  }

  Adw.PreferencesPage {
    title: _("Accounts");
    icon-name: "system-users-symbolic";

    // The status row, then the shared connection rows (ui/connection.blp).
    Adw.PreferencesGroup account {
      title: _("Account");

      // How Todav is connected now. Signed in here: "Sign Out", with signing in again in its
      // menu. Not connected: "Sign In with Browser". A GOA account is managed in GNOME Settings.
      Adw.ActionRow status {
        [prefix]
        Gtk.Image status_icon {
          icon-name: "object-select-symbolic";
          styles ["success"]
        }

        [suffix]
        Gtk.Button cancel_sign_in {
          label: _("Cancel");
          valign: center;
          visible: false;
          styles ["flat"]
        }

        [suffix]
        Adw.SplitButton sign_out {
          label: _("Sign Out");
          menu-model: sign_out_menu;
          dropdown-tooltip: _("Sign In Again");
          valign: center;
          styles ["destructive-action"]
        }

        [suffix]
        Adw.SplitButton sign_in {
          label: _("Sign In with Browser");
          menu-model: sign_in_menu;
          dropdown-tooltip: _("More Sign-In Options");
          valign: center;
        }
      }
    }

    Adw.PreferencesGroup push {
      title: _("Push");
      description: _("Changes are applied when this window closes");

      Adw.EntryRow ntfy {
        title: _("ntfy server for push (optional)");

        [prefix]
        Gtk.DropDown ntfy_scheme {
          valign: center;
          model: Gtk.StringList { strings ["https", "http"] };
          styles ["flat"]
        }

        [suffix]
        Gtk.Button ntfy_test {
          label: _("Test");
          valign: center;
          styles ["flat"]
        }
      }
    }

    Adw.PreferencesGroup sync {
      title: _("Sync");

      Adw.SwitchRow sync_settings {
        title: _("Sync settings with server");
        subtitle: _("The Nextcloud server always stays on this device");
        active: true;
      }

      Adw.SwitchRow sync_ntfy {
        title: _("Sync ntfy server");
        subtitle: _("Use the same push server on all devices");
        active: true;
        sensitive: bind sync_settings.active;
      }
    }

    // Kept on this device only (setting `local_mode`); off hides those lists, nothing is deleted.
    Adw.PreferencesGroup {
      title: _("On This Device");

      Adw.SwitchRow local_mode {
        title: _("Local lists and calendars");
        subtitle: _("Kept on this device only, never synced");
      }
    }
  }

  Adw.PreferencesPage {
    title: _("Tasks");
    icon-name: "checkbox-checked-symbolic";

    Adw.PreferencesGroup {
      title: _("Tasks");

      Adw.ComboRow task_sort {
        title: _("Sort");
        model: Gtk.StringList { strings [_("Manual"), _("Newest first"), _("Oldest first"), _("Due date, soonest first"), _("Due date, latest first"), _("Priority, highest first")] };
      }

      Adw.ComboRow task_new {
        title: _("Add new tasks");
        model: Gtk.StringList { strings [_("At the start"), _("At the end")] };
      }

      Adw.ComboRow done_tasks {
        title: _("Completed tasks");
        model: Gtk.StringList { strings [_("In a separate group"), _("Keep in place"), _("Move to the end")] };
      }

      // Entries as settings.rs DURATIONS lists them.
      Adw.ComboRow task_duration {
        title: _("Default duration");
        subtitle: _("When a task gets a time, or is planned on the calendar");
        model: Gtk.StringList { strings [_("15 minutes"), _("30 minutes"), _("45 minutes"), _("1 hour"), _("1.5 hours"), _("2 hours"), _("3 hours")] };
      }
    }

    Adw.PreferencesGroup {
      title: _("Stars and Pins");

      Adw.SwitchRow show_stars {
        title: _("Stars");
        subtitle: _("A star with each task’s priority, and the Important page");
      }

      Adw.SwitchRow show_pins {
        title: _("Pins");
        subtitle: _("Pin tasks to the top of their list");
      }
    }

    Adw.PreferencesGroup {
      title: _("Subtasks");

      Adw.ComboRow sub_sort {
        title: _("Sort");
        model: Gtk.StringList { strings [_("Manual"), _("Newest first"), _("Oldest first"), _("Due date, soonest first"), _("Due date, latest first"), _("Priority, highest first")] };
      }

      Adw.ComboRow sub_new {
        title: _("Add new subtasks");
        model: Gtk.StringList { strings [_("At the start"), _("At the end")] };
      }

      Adw.ComboRow done_subtasks {
        title: _("Completed subtasks");
        model: Gtk.StringList { strings [_("Show"), _("Hide"), _("Move to the end")] };
      }
    }

    Adw.PreferencesGroup {
      title: _("Reminders");

      Adw.ComboRow reminder_default {
        title: _("New reminders");
        subtitle: _("For tasks due at a time");
        model: Gtk.StringList reminder_defaults {};
      }

      Adw.ActionRow {
        title: _("Time for all-day tasks");
        subtitle: _("When reminders of tasks due on a date go off");

        [suffix]
        Gtk.SpinButton reminder_hour {
          valign: center;
          numeric: true;
          wrap: true;
          adjustment: Gtk.Adjustment {
            lower: 0;
            upper: 23;
            step-increment: 1;
          };
        }

        [suffix]
        Gtk.Label {
          label: ":";
        }

        [suffix]
        Gtk.SpinButton reminder_minute {
          valign: center;
          numeric: true;
          wrap: true;
          adjustment: Gtk.Adjustment {
            lower: 0;
            upper: 59;
            step-increment: 5;
          };
        }
      }
    }

    Adw.PreferencesGroup {
      title: _("Categories");

      Adw.ComboRow category_view {
        title: _("Show categories");
        model: Gtk.StringList { strings [_("Group by category"), _("As tags"), _("Hide")] };
      }
    }

    Adw.PreferencesGroup {
      title: _("Interaction");

      Adw.SwitchRow drag_handles {
        title: _("Drag handles");
        subtitle: _("Move tasks by a handle instead of the whole row, for touchscreens");
      }
    }
  }

  Adw.PreferencesPage {
    title: _("Calendar");
    icon-name: "x-office-calendar-symbolic";

    Adw.PreferencesGroup {
      title: _("Views");

      Adw.ComboRow start_calendar_view {
        title: _("View at start");
        model: Gtk.StringList { strings [_("Last used"), _("Month"), _("Week"), _("Agenda")] };
      }

      Adw.SwitchRow mini_dots {
        title: _("Dots in the sidebar month");
        subtitle: _("Mark the days that have events or tasks");
      }

      Adw.SwitchRow double_click_edit {
        title: _("Edit on double click");
        subtitle: _("Off, a click shows the details at once instead of after a short wait");
      }
    }

    Adw.PreferencesGroup {
      title: _("Events");

      // Entries as settings.rs DURATIONS lists them.
      Adw.ComboRow event_duration {
        title: _("Default duration");
        subtitle: _("When an event is added at a time, or an all-day one gets a time");
        model: Gtk.StringList { strings [_("15 minutes"), _("30 minutes"), _("45 minutes"), _("1 hour"), _("1.5 hours"), _("2 hours"), _("3 hours")] };
      }
    }
  }

  // The GNOME Shell extension's panel menu (ids are the settings' names, see settings.rs
  // EXTENSION).
  Adw.PreferencesPage {
    title: _("Extension");
    icon-name: "application-x-addon-symbolic";

    Adw.PreferencesGroup {
      title: _("Panel Menu");
      description: _("For the Todav GNOME Shell extension");

      Adw.ComboRow ext_columns {
        title: _("Layout");
        subtitle: _("Two columns: tasks on the left, calendar on the right");
        model: Gtk.StringList { strings [_("Two columns"), _("One column")] };
      }

      Adw.SwitchRow ext_open {
        title: _("“Open Todav” button");
      }
    }

    Adw.PreferencesGroup {
      title: _("Tasks");

      Adw.SwitchRow ext_tasks {
        title: _("Task list");
      }

      Adw.SwitchRow ext_subtasks {
        title: _("Subtasks");
        sensitive: bind ext_tasks.active;
      }

      Adw.SwitchRow ext_add_task {
        title: _("Field for adding a task");
      }
    }

    Adw.PreferencesGroup {
      title: _("Calendar");

      Adw.SwitchRow ext_month {
        title: _("Month calendar");
      }

      Adw.SwitchRow ext_month_dots {
        title: _("Dots in the month");
        subtitle: _("Mark the days that have events or tasks");
        sensitive: bind ext_month.active;
      }

      Adw.SwitchRow ext_agenda {
        title: _("Agenda");
        subtitle: _("Events and tasks of the coming week, under the month");
      }

      Adw.SwitchRow ext_add_event {
        title: _("Field for adding an event");
        subtitle: _("Opens a new event in Todav with the title typed");
      }
    }
  }
}

menu sign_out_menu {
  item (_("Sign In Again"), "account.sign-in")
  item (_("Copy Login Link"), "account.sign-in-copy")
  item (_("Sign In with Password…"), "account.sign-in-password")
}

menu sign_in_menu {
  item (_("Copy Login Link"), "account.sign-in-copy")
  item (_("Sign In with Password…"), "account.sign-in-password")
}
