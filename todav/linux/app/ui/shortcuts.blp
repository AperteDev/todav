using Gtk 4.0;
using Adw 1;

// Keyboard Shortcuts (Ctrl+?). Window-wide ones show the keys set in code by their action;
// the pages' own are set in their views.
Adw.ShortcutsDialog dialog {
  Adw.ShortcutsSection {
    title: _("General");

    Adw.ShortcutsItem {
      title: _("Search");
      accelerator: "<Control>f";
    }

    Adw.ShortcutsItem {
      title: _("Undo");
      action-name: "win.undo";
    }

    Adw.ShortcutsItem {
      title: _("Sync");
      action-name: "app.sync";
    }

    Adw.ShortcutsItem {
      title: _("Show Tasks");
      action-name: "win.page::tasks";
    }

    Adw.ShortcutsItem {
      title: _("Show Calendar");
      action-name: "win.page::calendar";
    }

    Adw.ShortcutsItem {
      title: _("Preferences");
      action-name: "win.preferences";
    }

    Adw.ShortcutsItem {
      title: _("Keyboard Shortcuts");
      action-name: "app.shortcuts";
    }

    Adw.ShortcutsItem {
      title: _("Close Window");
      action-name: "window.close";
    }

    Adw.ShortcutsItem {
      title: _("Quit");
      action-name: "app.quit";
    }
  }

  Adw.ShortcutsSection {
    title: _("Tasks");

    Adw.ShortcutsItem {
      title: _("New Task");
      accelerator: "<Control>n";
    }

    Adw.ShortcutsItem {
      title: _("Choose Category");
      accelerator: "<Control>k";
    }
  }

  Adw.ShortcutsSection {
    title: _("Calendar");

    Adw.ShortcutsItem {
      title: _("New Event");
      accelerator: "<Control>n";
    }

    Adw.ShortcutsItem {
      title: _("Today");
      accelerator: "<Control>t";
    }

    Adw.ShortcutsItem {
      title: _("Previous");
      accelerator: "<Alt>Left Page_Up";
    }

    Adw.ShortcutsItem {
      title: _("Next");
      accelerator: "<Alt>Right Page_Down";
    }

    Adw.ShortcutsItem {
      title: _("Month");
      accelerator: "<Control>1";
    }

    Adw.ShortcutsItem {
      title: _("Week");
      accelerator: "<Control>2";
    }

    Adw.ShortcutsItem {
      title: _("Agenda");
      accelerator: "<Control>3";
    }
  }
}
