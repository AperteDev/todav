using Gtk 4.0;

// The same Keyboard Shortcuts list for libadwaita older than 1.8, which has no
// Adw.ShortcutsDialog (Debian 13 has 1.7): GTK's own window. Keep it in step with shortcuts.blp.
Gtk.ShortcutsWindow dialog {
  modal: true;

  Gtk.ShortcutsSection {
    section-name: "shortcuts";
    max-height: 16;

    Gtk.ShortcutsGroup {
      title: _("General");

      Gtk.ShortcutsShortcut {
        title: _("Search");
        accelerator: "<Control>f";
      }

      Gtk.ShortcutsShortcut {
        title: _("Undo");
        action-name: "win.undo";
      }

      Gtk.ShortcutsShortcut {
        title: _("Sync");
        action-name: "app.sync";
      }

      Gtk.ShortcutsShortcut {
        title: _("Show Tasks");
        action-name: "win.page::tasks";
      }

      Gtk.ShortcutsShortcut {
        title: _("Show Calendar");
        action-name: "win.page::calendar";
      }

      Gtk.ShortcutsShortcut {
        title: _("Toggle Sidebar");
        action-name: "win.toggle-sidebar";
      }

      Gtk.ShortcutsShortcut {
        title: _("Preferences");
        action-name: "win.preferences";
      }

      Gtk.ShortcutsShortcut {
        title: _("Keyboard Shortcuts");
        action-name: "app.shortcuts";
      }

      Gtk.ShortcutsShortcut {
        title: _("Close Window");
        action-name: "window.close";
      }

      Gtk.ShortcutsShortcut {
        title: _("Quit");
        action-name: "app.quit";
      }
    }

    Gtk.ShortcutsGroup {
      title: _("Tasks");

      Gtk.ShortcutsShortcut {
        title: _("New Task");
        accelerator: "<Control>n";
      }

      Gtk.ShortcutsShortcut {
        title: _("Choose Category");
        accelerator: "<Control>k";
      }
    }

    Gtk.ShortcutsGroup {
      title: _("Calendar");

      Gtk.ShortcutsShortcut {
        title: _("New Event");
        accelerator: "<Control>n";
      }

      Gtk.ShortcutsShortcut {
        title: _("Today");
        accelerator: "<Control>t";
      }

      Gtk.ShortcutsShortcut {
        title: _("Previous");
        accelerator: "<Alt>Left Page_Up";
      }

      Gtk.ShortcutsShortcut {
        title: _("Next");
        accelerator: "<Alt>Right Page_Down";
      }

      Gtk.ShortcutsShortcut {
        title: _("Month");
        accelerator: "<Control>1";
      }

      Gtk.ShortcutsShortcut {
        title: _("Week");
        accelerator: "<Control>2";
      }

      Gtk.ShortcutsShortcut {
        title: _("Work Week");
        accelerator: "<Control>3";
      }

      Gtk.ShortcutsShortcut {
        title: _("3 Days");
        accelerator: "<Control>4";
      }

      Gtk.ShortcutsShortcut {
        title: _("Day");
        accelerator: "<Control>5";
      }

      Gtk.ShortcutsShortcut {
        title: _("Agenda");
        accelerator: "<Control>6";
      }
    }
  }
}
