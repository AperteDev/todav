[Desktop Entry]
Name=Todav
Comment=Tasks and calendar for Nextcloud and CalDAV
Exec=todav-linux %U
Icon=dev.aperte.Todav
Terminal=false
Type=Application
Categories=Office;ProjectManagement;
Keywords=todo;tasks;calendar;events;caldav;nextcloud;
MimeType=text/calendar;x-scheme-handler/todav;
DBusActivatable=true
StartupNotify=true
