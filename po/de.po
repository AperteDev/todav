#: todav/linux/data/io.github.selfref.Todav.desktop:2
#: todav/linux/data/io.github.selfref.Todav.metainfo.xml:6
msgid "Todav"
msgstr "Todav"

#: todav/linux/data/io.github.selfref.Todav.desktop:3
#: todav/linux/data/io.github.selfref.Todav.metainfo.xml:7
msgid "Tasks and calendar kept in your Nextcloud"
msgstr "Aufgaben und Kalender in Ihrer Nextcloud"

#: todav/linux/data/io.github.selfref.Todav.desktop:9
msgid "todo;tasks;calendar;events;caldav;nextcloud;"
msgstr "Aufgaben;Kalender;Termine;todo;tasks;calendar;caldav;nextcloud;"

#: todav/linux/data/io.github.selfref.Todav.metainfo.xml:9
msgid ""
"Todav is a task list and calendar kept in your Nextcloud through CalDAV, so "
"the Nextcloud Tasks and Calendar web apps and other CalDAV clients see the "
"same lists and events."
msgstr ""
"Todav ist eine Aufgabenliste und ein Kalender, die per CalDAV in Ihrer "
"Nextcloud liegen, sodass die Web-Apps Aufgaben und Kalender von Nextcloud "
"und andere CalDAV-Programme dieselben Listen und Termine sehen."

#: todav/linux/data/io.github.selfref.Todav.metainfo.xml:14
msgid "Works offline; changes sync when the server is reachable"
msgstr ""
"Funktioniert offline; Änderungen werden synchronisiert, sobald der Server "
"erreichbar ist"

#: todav/linux/data/io.github.selfref.Todav.metainfo.xml:15
msgid "Changes from other devices arrive within seconds through push"
msgstr ""
"Änderungen von anderen Geräten kommen per Push innerhalb von Sekunden an"

#: todav/linux/data/io.github.selfref.Todav.metainfo.xml:16
msgid "Categories, subtasks, due dates and reminders"
msgstr "Kategorien, Unteraufgaben, Fälligkeiten und Erinnerungen"

#: todav/linux/data/io.github.selfref.Todav.metainfo.xml:17
msgid ""
"Month, week and agenda views; plan tasks into time slots by drag and drop"
msgstr ""
"Monats-, Wochen- und Agendaansicht; Aufgaben per Ziehen und Ablegen in "
"Zeitfenster einplanen"

#: todav/linux/data/io.github.selfref.Todav.metainfo.xml:18
msgid "A GNOME Shell extension with your tasks and calendar in the top bar"
msgstr ""
"Eine GNOME-Shell-Erweiterung mit Ihren Aufgaben und Ihrem Kalender in der "
"oberen Leiste"

#: todav/linux/data/io.github.selfref.Todav.metainfo.xml:19
msgid "Connects through GNOME Online Accounts or a browser sign-in"
msgstr "Verbindet sich über GNOME-Online-Konten oder eine Anmeldung im Browser"

#: todav/linux/data/io.github.selfref.Todav.metainfo.xml:23
msgid "SelfRef"
msgstr "SelfRef"

